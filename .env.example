# ==========================================
# VOW & VIBE AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key
# Optional: If not provided, Vow & Vibe AI operates in high-quality Local Intelligence Fallback Mode
# ensuring 100% demo functionality without API credentials or rate-limit concerns.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Persistence (Optional)
# If provided, enables multi-user cloud synchronization.
# If omitted, robust browser-level LocalStorage persistence is automatically active.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
